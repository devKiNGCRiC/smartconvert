<?xml version="1.0" encoding="utf-8"?>
<!-- A saved conversion: category and time, then "value unit -> value unit", then actions. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <!-- Category, time, favourite -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/categoryChip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:textAppearance="@style/TextAppearance.SC.BodySmall"
                android:textColor="@color/text_strong"
                app:chipBackgroundColor="@color/surface_sunk"
                app:chipMinHeight="26dp"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="false"
                tools:text="Length" />

            <TextView
                android:id="@+id/timestampText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.SC.BodySmall"
                android:textColor="@color/text_faint"
                tools:text="2 hours ago" />

            <ImageView
                android:id="@+id/favoriteIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/toggle_favorite"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_star_border"
                app:tint="@color/text_faint" />
        </LinearLayout>

        <!-- The conversion -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/inputValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SC.ReadoutSmall"
                    android:textColor="@color/text_muted"
                    tools:text="100" />

                <TextView
                    android:id="@+id/fromUnitText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SC.BodyMedium"
                    android:textColor="@color/text_muted"
                    tools:text="Centimeter" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/converts_to"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/text_faint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/resultValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SC.ReadoutSmall"
                    android:textColor="@color/text_strong"
                    tools:text="39.37" />

                <TextView
                    android:id="@+id/toUnitText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SC.BodyMedium"
                    android:textColor="@color/text_muted"
                    tools:text="Inch" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteButton"
                style="@style/Widget.SC.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:textColor="@color/danger"
                app:icon="@drawable/ic_delete"
                app:iconSize="18dp"
                app:iconTint="@color/danger" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reuseButton"
                style="@style/Widget.SC.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reuse"
                app:icon="@drawable/ic_refresh"
                app:iconSize="18dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
