<?xml version="1.0" encoding="utf-8"?>
<!--
    History entry as a railway ticket (TicketDrawable set in HistoryAdapter).
    Journey on the left, stub on the right with favourite, time and delete.
    Tap the ticket to reuse the conversion; swipe to delete.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/ticketBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="128dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="0.76"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/categoryChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:textAppearance="@style/TextAppearance.SC.Overline"
                tools:text="Length" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/inputValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/scFontDisplay"
                    android:maxLines="1"
                    android:textColor="?attr/scInkMuted"
                    android:textSize="18sp"
                    tools:text="1,250" />

                <TextView
                    android:id="@+id/fromUnitText"
            android:textAppearance="@style/TextAppearance.SC.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/scInkMuted"
                    tools:text="Kilometer" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/resultValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/scFontDisplay"
                    android:maxLines="1"
                    android:textColor="?attr/scInk"
                    android:textSize="24sp"
                    tools:text="12,50,000" />

                <TextView
                    android:id="@+id/toUnitText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SC.Subtitle"
                    tools:text="Meter" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.24"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/favoriteIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/toggle_favorite"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_star_border"
                app:tint="?attr/scInkFaint" />

            <TextView
                android:id="@+id/timestampText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:gravity="center"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.SC.Caption"
                android:textColor="?attr/scInkFaint"
                android:textSize="12sp"
                tools:text="2 hr. ago" />

            <ImageView
                android:id="@+id/deleteButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/delete"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_delete"
                app:tint="?attr/scInkFaint" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
