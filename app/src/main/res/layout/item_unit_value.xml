<?xml version="1.0" encoding="utf-8"?>
<!-- One row of "In every unit": symbol badge, unit name (+ note), converted value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/rowSymbol"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_badge"
        android:fontFamily="?attr/scFontDisplay"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="#FFFFFFFF"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="7sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        tools:text="ft" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SC.Subtitle"
            android:textSize="16sp"
            tools:text="Foot" />

        <TextView
            android:id="@+id/rowNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SC.Caption"
            android:textColor="?attr/scInkMuted"
            tools:text="Imperial and US" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="?attr/scFontDisplay"
        android:gravity="end"
        android:maxWidth="180dp"
        android:maxLines="1"
        android:textColor="?attr/scInk"
        android:textSize="18sp"
        tools:text="41,01,049.9" />
</LinearLayout>
