<?xml version="1.0" encoding="utf-8"?>
<!--
    Conversion screen. The tapped home tile grows into this screen
    (container transform onto conversionRoot).

    Hero (category hue): title, magnitude dial, big result and the result in
    words ("12.5 lakh"). Below, overlapping the hero: one card holding the
    From unit and value, a raised swap knob, and the To unit. Then quick
    values and the value in every unit of the category.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conversionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/scBg"
    tools:context=".ConversionActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/conversionScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- ===== Hero ===== -->
            <FrameLayout
                android:id="@+id/convHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.unitconverter.app.presentation.widget.PatternView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:pattern="?attr/scPattern"
                    app:patternAlpha="0.16"
                    app:patternFade="1"
                    app:patternTint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/watermark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="-8dp"
                    android:alpha="0.12"
                    android:fontFamily="?attr/scFontDisplay"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="150sp"
                    tools:text="m" />

                <LinearLayout
                    android:id="@+id/convHeroContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="52dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/backButton"
                            style="@style/Widget.SC.GlassIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/cd_back_button"
                            app:backgroundTint="#26FFFFFF"
                            app:icon="@drawable/ic_back"
                            app:iconTint="#FFFFFFFF"
                            app:strokeColor="#40FFFFFF" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/categoryTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="?attr/scFontDisplay"
                                android:includeFontPadding="false"
                                android:textColor="#FFFFFFFF"
                                android:textSize="28sp"
                                tools:text="Length" />

                            <TextView
                                android:id="@+id/categorySubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.8"
                                android:textAppearance="@style/TextAppearance.SC.Caption"
                                android:textColor="#FFFFFFFF"
                                tools:text="15 units, 4 Indian" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/copyButton"
                            style="@style/Widget.SC.GlassIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/copy_result"
                            app:backgroundTint="#26FFFFFF"
                            app:icon="@drawable/ic_copy"
                            app:iconTint="#FFFFFFFF"
                            app:strokeColor="#40FFFFFF" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/shareButton"
                            style="@style/Widget.SC.GlassIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/share_result"
                            app:backgroundTint="#26FFFFFF"
                            app:icon="@drawable/ic_share"
                            app:iconTint="#FFFFFFFF"
                            app:strokeColor="#40FFFFFF" />
                    </LinearLayout>

                    <com.unitconverter.app.presentation.widget.ArcDialView
                        android:id="@+id/dial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="52dp"
                        app:dialColor="#FFFFFFFF"
                        app:dialNeedleColor="#FFFFFFFF"
                        app:dialTrackColor="#33FFFFFF" />

                    <TextView
                        android:id="@+id/resultValue"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:layout_marginTop="2dp"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.SC.Readout"
                        android:textColor="#FFFFFFFF"
                        app:autoSizeMaxTextSize="52sp"
                        app:autoSizeMinTextSize="22sp"
                        app:autoSizeStepGranularity="2sp"
                        app:autoSizeTextType="uniform"
                        tools:text="12,50,000" />

                    <TextView
                        android:id="@+id/resultUnit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.SC.Subtitle"
                        android:textColor="#FFFFFFFF"
                        tools:text="Meter (m)" />

                    <TextView
                        android:id="@+id/resultWords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.85"
                        android:gravity="center"
                        android:minHeight="22dp"
                        android:textAppearance="@style/TextAppearance.SC.Body"
                        android:textColor="#FFFFFFFF"
                        tools:text="12.5 lakh" />


                </LinearLayout>
            </FrameLayout>

            <!-- ===== Input card (overlaps the hero) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/inputCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-40dp"
                android:layout_marginEnd="16dp"
                app:cardElevation="10dp"
                app:shapeAppearance="@style/ShapeAppearance.SC.Card"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <!-- From unit -->
                        <LinearLayout
                            android:id="@+id/fromUnitCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <TextView
                                android:id="@+id/fromSymbol"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_badge"
                                android:fontFamily="?attr/scFontDisplay"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:maxLines="1"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:textColor="#FFFFFFFF"
                                app:autoSizeMaxTextSize="16sp"
                                app:autoSizeMinTextSize="7sp"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeTextType="uniform"
                                tools:text="km" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:importantForAccessibility="no"
                                    android:text="@string/from_label"
                                    android:textAppearance="@style/TextAppearance.SC.Overline" />

                                <TextView
                                    android:id="@+id/fromName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:importantForAccessibility="no"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.SC.Subtitle"
                                    tools:text="Kilometer" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="?attr/scInkMuted" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:hint="@string/input_hint"
                            app:endIconMode="clear_text"
                            app:errorEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="?attr/scFontDisplay"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLines="1"
                                android:textColor="?attr/scInk"
                                android:textSize="30sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <View
                            android:id="@+id/fromToDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="88dp"
                            android:background="?attr/scLine" />

                        <!-- To unit -->
                        <LinearLayout
                            android:id="@+id/toUnitCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <TextView
                                android:id="@+id/toSymbol"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_badge"
                                android:fontFamily="?attr/scFontDisplay"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:maxLines="1"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:textColor="#FFFFFFFF"
                                app:autoSizeMaxTextSize="16sp"
                                app:autoSizeMinTextSize="7sp"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeTextType="uniform"
                                tools:text="m" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:importantForAccessibility="no"
                                    android:text="@string/to_label"
                                    android:textAppearance="@style/TextAppearance.SC.Overline" />

                                <TextView
                                    android:id="@+id/toName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:importantForAccessibility="no"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.SC.Subtitle"
                                    tools:text="Meter" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="?attr/scInkMuted" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Raised swap knob on the divider -->
                    <ImageButton
                        android:id="@+id/swapButton"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="end"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_swap_knob"
                        android:contentDescription="@string/cd_swap_units"
                        android:elevation="6dp"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_swap"
                        android:tooltipText="@string/swap_button"
                        app:tint="?attr/scOnAccent" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Quick values ===== -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/quickChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:singleLine="true" />
            </HorizontalScrollView>

            <!-- ===== In every unit ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:text="@string/every_unit_title"
                android:textAppearance="@style/TextAppearance.SC.Headline"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="@string/every_unit_hint"
                android:textAppearance="@style/TextAppearance.SC.Caption"
                android:textColor="?attr/scInkMuted" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/allUnitsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_unit_value" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
