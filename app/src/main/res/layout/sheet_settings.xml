<?xml version="1.0" encoding="utf-8"?>
<!-- Look and feel: mood, light/dark, number system, Indian units, Hindi greetings. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.SC.Headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:accessibilityHeading="true"
            android:text="@string/settings_mood"
            android:textAppearance="@style/TextAppearance.SC.Overline" />

        <LinearLayout
            android:id="@+id/moodRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:accessibilityHeading="true"
            android:text="@string/settings_appearance"
            android:textAppearance="@style/TextAppearance.SC.Overline" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/appearanceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/appearanceSystem"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/appearance_system"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/appearanceLight"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/appearance_light"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/appearanceDark"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/appearance_dark"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:accessibilityHeading="true"
            android:text="@string/settings_numbers"
            android:textAppearance="@style/TextAppearance.SC.Overline" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/numbersGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/numbersAuto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/numbers_auto"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/numbersInternational"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/numbers_international"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/numbersIndian"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/numbers_indian"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/numbers_hint"
            android:textAppearance="@style/TextAppearance.SC.Caption"
            android:textColor="?attr/scInkMuted" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/indianUnitsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="56dp"
            android:text="@string/settings_indian_units"
            android:textAppearance="@style/TextAppearance.SC.Subtitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:text="@string/settings_indian_units_hint"
            android:textAppearance="@style/TextAppearance.SC.Caption"
            android:textColor="?attr/scInkMuted" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/hindiSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="56dp"
            android:text="@string/settings_hindi"
            android:textAppearance="@style/TextAppearance.SC.Subtitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:text="@string/settings_hindi_hint"
            android:textAppearance="@style/TextAppearance.SC.Caption"
            android:textColor="?attr/scInkMuted" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
