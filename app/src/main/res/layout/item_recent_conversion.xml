<?xml version="1.0" encoding="utf-8"?>
<!--
    Recent conversion as a railway ticket: journey on the left
    ("1,250 km" to "12,50,000 m"), stub on the right with the favourite star.
    The ticket background is a TicketDrawable set in RecentConversionsAdapter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ticket"
    android:layout_width="264dp"
    android:layout_height="124dp"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.76"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/ticketCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:textAppearance="@style/TextAppearance.SC.Overline"
            tools:text="Length" />

        <TextView
            android:id="@+id/ticketFrom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="?attr/scFontDisplay"
            android:maxLines="1"
            android:textColor="?attr/scInkMuted"
            android:textSize="18sp"
            tools:text="1,250 km" />

        <TextView
            android:id="@+id/conversionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="?attr/scFontDisplay"
            android:maxLines="1"
            android:textColor="?attr/scInk"
            android:textSize="22sp"
            tools:text="12,50,000 m" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.24"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/favoriteIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/toggle_favorite"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_star_border"
            app:tint="?attr/scInkFaint" />

        <TextView
            android:id="@+id/timestampText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:gravity="center"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.SC.Caption"
            android:textColor="?attr/scInkFaint"
            android:textSize="12sp"
            tools:text="2 hr. ago" />
    </LinearLayout>
</LinearLayout>
