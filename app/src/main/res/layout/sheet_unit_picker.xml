<?xml version="1.0" encoding="utf-8"?>
<!-- Searchable unit picker, grouped into Metric / Imperial and US / Indian traditional / Standard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/pickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:textAppearance="@style/TextAppearance.SC.Headline"
        android:text="@string/choose_to_unit" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/pickerSearchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/pickerSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_units"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SC.BodyLarge" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/pickerEmpty"
            android:textAppearance="@style/TextAppearance.SC.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/no_units_match"
        android:textColor="?attr/scInkMuted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pickerList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="24dp" />
</LinearLayout>
