<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        "Tape measure" palette.
        Drafting-paper neutrals, slate ink, and one accent: tape-measure yellow.
        Night values live in values-night/colors.xml under the same names.
    -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Neutrals -->
    <color name="paper">#EEF1EF</color>          <!-- screen background -->
    <color name="surface">#F9FBFA</color>        <!-- tiles, fields, lists -->
    <color name="surface_sunk">#E3E8E6</color>   <!-- pressed / inset -->
    <color name="rule">#CCD5D3</color>           <!-- hairlines and outlines -->

    <!-- Text -->
    <color name="text_strong">#1C2A33</color>
    <color name="text_muted">#56656E</color>
    <color name="text_faint">#86939A</color>

    <!-- Accent -->
    <color name="tape">#F2C230</color>           <!-- the result tape -->
    <color name="tape_pressed">#E0AF17</color>
    <color name="on_tape">#1C2A33</color>        <!-- always dark ink, both themes -->
    <color name="mark">#A87C00</color>           <!-- favourite star -->

    <color name="danger">#B3261E</color>
    <color name="ripple">#1F1C2A33</color>

    <!-- Material role aliases -->
    <color name="primary">@color/text_strong</color>
    <color name="error">@color/danger</color>
</resources>
