<?xml version="1.0" encoding="utf-8"?>
<!-- Soft, raised knob: dark shadow down-right, light highlight up-left, accent face. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="oval"><solid android:color="#26000000" /></shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval"><solid android:color="#59FFFFFF" /></shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="?attr/scAccent" />
            <stroke android:width="2dp" android:color="?attr/scSurface" />
        </shape>
    </item>
</layer-list>
