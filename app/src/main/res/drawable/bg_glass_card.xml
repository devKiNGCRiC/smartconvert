<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism card background with blur effect simulation -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <solid android:color="@color/glass_background" />
    
    <corners android:radius="@dimen/corner_large" />
    
    <stroke
        android:width="@dimen/stroke_thin"
        android:color="@color/glass_border" />
    
    <padding
        android:left="@dimen/padding_standard"
        android:top="@dimen/padding_standard"
        android:right="@dimen/padding_standard"
        android:bottom="@dimen/padding_standard" />
</shape>
