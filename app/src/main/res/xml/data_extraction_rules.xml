<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for Android 12+. Only the conversion history database is copied. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
